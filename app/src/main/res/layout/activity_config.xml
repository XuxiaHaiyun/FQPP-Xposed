<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/configToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="FQ++ 配置"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 配置说明 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="配置说明"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="配置保存在本模块应用内，番茄小说进程会自动读取。部分功能需要重启番茄小说后才能生效。"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HTTP Server 配置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="接口服务"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/portLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="端口号（0 到 65535）"
                        app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="0dp"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/portInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="5"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout style="@style/FeatureRow" android:paddingStart="0dp" android:paddingEnd="0dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="随番茄小说启动"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/startWithAppSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="?android:attr/listDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="开启后，番茄小说启动时会自动拉起本地接口服务，供书源导入和阅读器对接使用。"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 其他功能 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="12dp"
                        android:text="其他功能"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_block" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="屏蔽更新"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/blockUpdatesSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_verified" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本地会员"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/localVipSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_lock_open" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="解锁书籍"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/unlockBooksSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_warning" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="崩溃上报（打开禁用）"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/blockCrashReportSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_block" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="热更新（打开禁用）"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/blockHotUpdateSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_block" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="加载插件（打开禁用）"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/blockPluginLoadSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_settings" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="界面净化"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_verified" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="激励秒领"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/instantRewardSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_access_time" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="阅读时长（5x）"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/readingTimeX2Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <ImageView style="@style/FeatureBadge" android:src="@drawable/ic_bug" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="调试模块"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/debugModeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 界面净化细分 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/uiCleanSubCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="界面净化细分"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="12dp"
                        android:text="需先开启界面净化总开关，细分项默认全部开启"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="搜索框轮播提示"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanSearchWordSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="全屏福利广告弹窗"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanScreenAdSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的页会员特权卡"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanVipCardSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="功能区/滑栏红点角标"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanFunctionBadgeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="侧滑 “常玩游戏”"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanMiniGameSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="底部 TAB 角标"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanTabBadgeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的页小说推荐"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanMineFeedSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="主页“赚钱”导航栏"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHomeEarnTabSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="主页“短剧”导航栏"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHomeSeriesTabSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="发表帖子/话题/书单按钮"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHidePublishSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的页金币信息"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHideMineAssetSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的页浏览历史外显"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHideMineHistorySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="主页“点击赚钱”挂件"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanHideMineEarnPendantSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="搜索页热搜榜/AI 板块"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanSearchResultSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/FeatureDivider" />

                    <LinearLayout style="@style/FeatureRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="搜索页 AI 入口"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/uiCleanSearchAiSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="保存配置"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="导入书源"
                app:cornerRadius="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="修改配置后，请重启番茄应用使改动生效。"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
