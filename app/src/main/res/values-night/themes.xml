<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Primary -->
    <item name="colorPrimary">#82DCA8</item>
    <item name="colorOnPrimary">#003826</item>
    <item name="colorPrimaryContainer">#00532F</item>
    <item name="colorOnPrimaryContainer">#A4F1C1</item>
    <!-- Secondary -->
    <item name="colorSecondary">#B4D0C2</item>
    <item name="colorOnSecondary">#1C3329</item>
    <item name="colorSecondaryContainer">#344B40</item>
    <item name="colorOnSecondaryContainer">#D0E8DA</item>
    <!-- Tertiary -->
    <item name="colorTertiary">#A3CDE0</item>
    <item name="colorOnTertiary">#073542</item>
    <item name="colorTertiaryContainer">#224B5B</item>
    <item name="colorOnTertiaryContainer">#BFE9FA</item>
    <!-- Error -->
    <item name="colorError">#FFB4AB</item>
    <item name="colorOnError">#690005</item>
    <item name="colorErrorContainer">#93000A</item>
    <item name="colorOnErrorContainer">#FFDAD6</item>
    <!-- Surface / Background -->
    <item name="android:colorBackground">#0E1512</item>
    <item name="colorOnBackground">#DDE5DF</item>
    <item name="colorSurface">#0E1512</item>
    <item name="colorOnSurface">#DDE5DF</item>
    <item name="colorSurfaceVariant">#3F4944</item>
    <item name="colorOnSurfaceVariant">#BEC9C2</item>
    <item name="colorSurfaceContainerLowest">#090F0C</item>
    <item name="colorSurfaceContainerLow">#131915</item>
    <item name="colorSurfaceContainer">#1A211E</item>
    <item name="colorSurfaceContainerHigh">#242B28</item>
    <item name="colorSurfaceContainerHighest">#2F362F</item>
    <!-- Outline -->
    <item name="colorOutline">#89938D</item>
    <item name="colorOutlineVariant">#3F4944</item>
    <!-- Dialog -->
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>
    <!-- System bars -->
    <item name="android:statusBarColor">?attr/colorSurface</item>
    <item name="android:navigationBarColor">?attr/colorSurface</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme" />
</resources>
